{
  "name": "euclid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Math learning game for 7th grade - conquer continents by solving math missions",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node tools/e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run e2e"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
